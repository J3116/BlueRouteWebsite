@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en-US";
    var isArabic = currentCulture.StartsWith("ar");
    var dir = isArabic ? "rtl" : "ltr";
    var lang = isArabic ? "ar" : "en";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - Blue Route Marine Consultancy</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="~/favicon.ico.png" rel="icon" type="image/png">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap & Template Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">

    <!-- Your Custom Marine Color Overrides -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <!-- Protect Icons from RTL Font Overrides -->
    <!-- Protect Icons and Footer from RTL Overrides -->
    <style>
        /* 1. Restore Broken Icons */
        [dir="rtl"] .fa,
        [dir="rtl"] .fas,
        [dir="rtl"] .far {
            font-family: "Font Awesome 5 Free" !important;
            font-weight: 900 !important;
        }

        [dir="rtl"] .fab {
            font-family: "Font Awesome 5 Brands" !important;
            font-weight: 400 !important;
        }

        /* 2. Fix Footer Link Arrows & Alignment */
        [dir="rtl"] .footer .btn.btn-link {
            text-align: right !important;
            padding-right: 0 !important;
        }

            [dir="rtl"] .footer .btn.btn-link::before {
                content: "\f104" !important; /* Left chevron */
                margin-right: 0 !important;
                margin-left: 10px !important;
            }

        /* 3. Flip the Newsletter Plane */
        [dir="rtl"] .fa-paper-plane {
            transform: scaleX(-1);
        }
    </style>
</head>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
        <!-- Navbar Start -->
        <div class="container-xxl position-relative p-0">
            <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand p-0 d-flex align-items-center">
                    <img src="~/img/logo-icon.png" alt="Blue Route Logo" style="height: 48px; width: auto;" class="@(isArabic ? "ms-2" : "me-2")" />
                    <div class="d-flex flex-column text-start">
                        <span class="fw-bold text-white lh-1 fs-4" style="letter-spacing: 0.5px;">
                            @(isArabic ? "المسار الأزرق" : "BLUE ROUTE")
                        </span>
                        <small class="text-white-50 text-uppercase fw-semibold mt-1" style="font-size: 0.65rem; letter-spacing: 1px;">
                            @(isArabic ? "للاستشارات البحرية" : "MARINE CONSULTANCY")
                        </small>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCollapse">
                    @{
                        var c = ViewContext.RouteData.Values["controller"]?.ToString();
                        var a = ViewContext.RouteData.Values["action"]?.ToString();
                    }
                    <div class="navbar-nav ms-auto p-4 p-lg-0">
                        <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @(c == "Home" && (a == "Index" || string.IsNullOrEmpty(a)) ? "active" : "")">
                            @(isArabic ? "الرئيسية" : "Home")
                        </a>
                        <a asp-controller="Home" asp-action="About" class="nav-item nav-link @(c == "Home" && a == "About" ? "active" : "")">
                            @(isArabic ? "من نحن" : "About")
                        </a>
                        <a asp-controller="Services" asp-action="Index" class="nav-item nav-link @(c == "Services" ? "active" : "")">
                            @(isArabic ? "الخدمات" : "Services")
                        </a>
                     
                        <a asp-controller="Contact" asp-action="Index" class="nav-item nav-link @(c == "Contact" ? "active" : "")">
                            @(isArabic ? "اتصل بنا" : "Contact")
                        </a>
                    </div>

                    <a asp-controller="Contact" asp-action="Index" class="btn btn-primary rounded-pill py-2 px-4 ms-3 d-none d-lg-block">
                        @(isArabic ? "تواصل معنا" : "Get In Touch")
                    </a>

                    <form asp-controller="Language" asp-action="SetLanguage"
                          asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                          method="post" class="d-inline ms-lg-3 my-2 my-lg-0">
                        @if (isArabic)
                        {
                            <input type="hidden" name="culture" value="en-US" />
                            <button type="submit" class="btn btn-outline-light rounded-pill px-3">
                                <i class="fa fa-globe me-1"></i> English
                            </button>
                        }
                        else
                        {
                            <input type="hidden" name="culture" value="ar-JO" />
                            <button type="submit" class="btn btn-outline-light rounded-pill px-3 fw-bold">
                                <i class="fa fa-globe me-1"></i> العربية
                            </button>
                        }
                    </form>
                </div>
            </nav>
        </div>
        <!-- Navbar End -->

        <main role="main">
            @RenderBody()
        </main>

        <!-- Footer Start -->
        <div class="container-fluid bg-dark text-light footer pt-5 wow fadeIn" data-wow-delay="0.1s" style="margin-top: 6rem;" dir="@(isArabic ? "rtl" : "ltr")">
            <div class="container py-5 text-md-start @(isArabic ? "text-end" : "text-start")">
                <div class="row g-5">
                    <div class="col-md-6 col-lg-3">
                        <h5 class="text-white mb-4">@(isArabic ? "تواصل معنا" : "Get In Touch")</h5>
                        <p><i class="fa fa-map-marker-alt @(isArabic ? "ms-3" : "me-3")"></i>@(isArabic ? "عمان، الأردن" : "Amman, Jordan")</p>
                        <p><i class="fa fa-phone-alt @(isArabic ? "ms-3" : "me-3")"></i>+962 6 000 0000</p>
                        <p><i class="fa fa-envelope @(isArabic ? "ms-3" : "me-3")"></i><a href="mailto:info@bluerouteconsultancy.com" class="text-light text-decoration-none">info@bluerouteconsultancy.com</a></p>
                        <div class="d-flex pt-2 gap-2">
                           <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-twitter"></i></a>
                            <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-outline-light btn-social" href="#"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <h5 class="text-white mb-4">@(isArabic ? "روابط سريعة" : "Quick Links")</h5>
                        <a class="btn btn-link ps-0" asp-controller="Home" asp-action="About">@(isArabic ? "من نحن" : "About Us")</a>
                        <a class="btn btn-link ps-0" asp-controller="Services" asp-action="Index">@(isArabic ? "الخدمات" : "Services")</a>
                        <a class="btn btn-link ps-0" asp-controller="Contact" asp-action="Index">@(isArabic ? "اتصل بنا" : "Contact Us")</a>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <h5 class="text-white mb-4">@(isArabic ? "الخدمات" : "Services")</h5>
                        <a class="btn btn-link ps-0" href="#">@(isArabic ? "معاينة البدن والآلات" : "Hull Inspections")</a>
                        <a class="btn btn-link ps-0" href="#">@(isArabic ? "معاينة البضائع البحرية" : "Marine Cargo Surveys")</a>
                        <a class="btn btn-link ps-0" href="#">@(isArabic ? "تدقيق السلامة" : "Safety Audits")</a>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <h5 class="text-white mb-4">@(isArabic ? "النشرة البريدية" : "Newsletter")</h5>
                        <p>@(isArabic ? "اشترك في نشرتنا البريدية للحصول على آخر تحديثات قطاع البحرية." : "Subscribe to our newsletter for marine industry updates.")</p>
                        <div class="position-relative w-100 mt-3">
                            <input class="form-control border-0 rounded-pill w-100 @(isArabic ? "pe-4 ps-5 text-end" : "ps-4 pe-5")" type="text" placeholder="@(isArabic ? "بريدك الإلكتروني" : "Your Email")" style="height: 48px;" dir="ltr">
                            <button type="button" class="btn shadow-none position-absolute top-0 @(isArabic ? "start-0 ms-2" : "end-0 me-2") mt-1"><i class="fa fa-paper-plane text-primary fs-4"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="copyright border-top border-secondary py-4">
                    <div class="row">
                        <div class="col-md-12 text-center">
                            &copy; @DateTime.Now.Year <a class="border-bottom text-white" href="#">Blue Route Marine Consultancy</a>, @(isArabic ? "جميع الحقوق محفوظة." : "All Rights Reserved.")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->

        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>